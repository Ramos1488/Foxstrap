<Window x:Class="Foxstrap.Windows.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foxstrap" Height="320" Width="460"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Background="#11111B" CornerRadius="10" BorderBrush="#27273A" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" Text="Удаление Foxstrap"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#CDD6F4" Margin="0,0,0,8"/>
                <TextBlock x:Name="DescText" TextWrapping="Wrap"
                           FontSize="13" Foreground="#A6ADC8" Margin="0,0,0,20">
Удаление уберёт Foxstrap с вашей системы. Roblox вернётся к стандартному лаунчеру.
                </TextBlock>

                <!-- Опция сохранения данных -->
                <Border Background="#1E1E2E" CornerRadius="8"
                        Padding="14,12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Оставить настройки и моды"
                                       FontSize="13" Foreground="#CDD6F4"/>
                            <TextBlock FontSize="11" Foreground="#6C7086"
                                       TextWrapping="Wrap" Margin="0,3,0,0">
Они будут восстановлены при переустановке.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox x:Name="KeepData" Grid.Column="1"
                                  IsChecked="True"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="InstallPathText" FontSize="11"
                           Foreground="#45475A" TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <ProgressBar x:Name="UninstallProgress" Grid.Row="1"
                         Height="4" Minimum="0" Maximum="100" Value="0"
                         Background="#1E1E2E" Foreground="#F38BA8"
                         BorderBrush="Transparent"
                         Margin="0,0,0,16" Visibility="Collapsed"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="UninstallBtn" Content="Удалить"
                        Click="Uninstall_Click" Padding="18,8" Margin="0,0,8,0"
                        Background="#F38BA8" Foreground="#1E1E2E"
                        BorderBrush="Transparent" FontWeight="SemiBold" Cursor="Hand"/>
                <Button x:Name="CancelBtn" Content="Отмена"
                        Click="Cancel_Click" Padding="18,8"
                        Background="#1E1E2E" Foreground="#CDD6F4"
                        BorderBrush="#27273A" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
