<Window x:Class="Foxstrap.Windows.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="220"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Background="#1E1E2E" CornerRadius="12"
            BorderBrush="#313244" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Margin="32">
            <Border Width="72" Height="72" CornerRadius="16"
                    Background="#313244" HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <TextBlock x:Name="LogoText" Text="F" FontSize="36"
                           FontWeight="Bold" Foreground="#CBA6F7"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="StatusText" Text="Запускаем Roblox..."
                       FontSize="14" Foreground="#CDD6F4"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <ProgressBar x:Name="ProgressBar" Height="4" IsIndeterminate="True"
                         Background="#313244" Foreground="#CBA6F7"
                         BorderBrush="Transparent" Margin="0,0,0,16"/>
            <Button Content="Отменить" Click="CancelButton_Click"
                    HorizontalAlignment="Center" Padding="24,8"
                    Background="#313244" Foreground="#CDD6F4"
                    BorderBrush="#45475A" Cursor="Hand" FontSize="13"/>
        </StackPanel>
    </Border>
</Window>
