<Window x:Class="Foxstrap.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foxstrap Admin Panel" Height="580" Width="820"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Background="#11111B" CornerRadius="10" BorderBrush="#F38BA8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" Background="#0D0D17"
                  MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="🛡 " FontSize="14"/>
                    <TextBlock Text="Foxstrap Admin Panel" FontSize="13"
                               FontWeight="SemiBold" Foreground="#F38BA8"/>
                </StackPanel>
                <Button Content="✕" Width="36" Height="40" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#6C7086"
                        BorderBrush="Transparent" Click="CloseButton_Click" Cursor="Hand"/>
            </Grid>

            <!-- Контент -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Статистика -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                    <Border x:Name="StatTesters" Background="#1E1E2E" CornerRadius="8"
                            Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Тестеры" FontSize="11" Foreground="#A6ADC8"/>
                            <TextBlock x:Name="CountTesters" Text="0" FontSize="22"
                                       FontWeight="Bold" Foreground="#A6E3A1"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Модераторы" FontSize="11" Foreground="#A6ADC8"/>
                            <TextBlock x:Name="CountMods" Text="0" FontSize="22"
                                       FontWeight="Bold" Foreground="#89DCEB"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Администраторы" FontSize="11" Foreground="#A6ADC8"/>
                            <TextBlock x:Name="CountAdmins" Text="0" FontSize="22"
                                       FontWeight="Bold" Foreground="#CBA6F7"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="Всего" FontSize="11" Foreground="#A6ADC8"/>
                            <TextBlock x:Name="CountTotal" Text="0" FontSize="22"
                                       FontWeight="Bold" Foreground="#CDD6F4"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Форма добавления -->
                <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="8"
                        Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UsernameInput" Margin="0,0,8,0"
                                 Background="#27273A" Foreground="#CDD6F4"
                                 BorderBrush="Transparent" Padding="10,8"
                                 FontSize="13" Tag="Имя пользователя"
                                 GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"/>
                        <TextBox x:Name="RobloxIdInput" Grid.Column="1" Margin="0,0,8,0"
                                 Background="#27273A" Foreground="#CDD6F4"
                                 BorderBrush="Transparent" Padding="10,8"
                                 FontSize="13" Tag="Roblox ID (необязательно)"
                                 GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"/>
                        <ComboBox x:Name="RoleCombo" Grid.Column="2" Margin="0,0,8,0"
                                  Background="#27273A" Foreground="#CDD6F4"
                                  BorderBrush="Transparent" FontSize="13"
                                  SelectedIndex="0">
                            <ComboBoxItem>Тестер</ComboBoxItem>
                            <ComboBoxItem>Модератор</ComboBoxItem>
                            <ComboBoxItem>Администратор</ComboBoxItem>
                            <ComboBoxItem>Супер-Админ</ComboBoxItem>
                        </ComboBox>
                        <Button Grid.Column="3" Content="+ Добавить"
                                Click="AddUser_Click" Padding="16,8"
                                Background="#CBA6F7" Foreground="#1E1E2E"
                                BorderBrush="Transparent" FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Список пользователей -->
                <Border Grid.Row="2" Background="#0D0D17" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовки таблицы -->
                        <Grid Grid.Row="0" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Пользователь" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Roblox ID" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Роль" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Добавлен" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Действия" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="UserList" Margin="8,0,8,8"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Нижняя панель -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText" Text="Готов" FontSize="12"
                               Foreground="#6C7086" VerticalAlignment="Center"/>
                    <Button Content="Экспорт JSON" HorizontalAlignment="Right"
                            Click="Export_Click" Padding="14,7"
                            Background="#1E1E2E" Foreground="#CDD6F4"
                            BorderBrush="#45475A" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

