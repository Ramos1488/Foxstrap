<Window x:Class="Foxstrap.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Foxstrap"
        Width="1000" Height="650"
        MinWidth="860" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="44" Height="24"
                                CornerRadius="12" Background="#45475a">
                            <Ellipse x:Name="Thumb" Width="18" Height="18"
                                     Fill="White" HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#cba6f7"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Ind" CornerRadius="0,2,2,0" Background="Transparent"/>
                            <Border x:Name="Bg" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ind" Property="Background" Value="#cba6f7"/>
                                <Setter TargetName="Bg" Property="Background" Value="#26273a"/>
                                <Setter Property="Foreground" Value="#cdd6f4"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#20212e"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3d3f52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#292a3d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#cba6f7"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b58ff0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#f38ba8"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ БОКОВАЯ ПАНЕЛЬ ═══ -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="#181825">
            <DockPanel>

                <!-- Лого -->
                <Border DockPanel.Dock="Top" Padding="18,16,18,12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/foxstrap.png"
                               Width="28" Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Foxstrap" Foreground="#cdd6f4"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Кнопка Запустить -->
                <Border DockPanel.Dock="Top" Padding="12,0,12,10">
                    <Button Content="▶  Запустить Roblox"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Stretch"
                            Click="LaunchButton_Click"/>
                </Border>

                <!-- Разделитель -->
                <Border DockPanel.Dock="Top" Height="1" Background="#2a2a3d" Margin="12,0,12,4"/>

                <!-- Основное меню -->
                <StackPanel DockPanel.Dock="Top">

                    <RadioButton x:Name="NavIntegrations" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Tag="Integrations" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center"/>
                            <TextBlock Text="Интеграции" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLauncher" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Tag="Launcher" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center"/>
                            <TextBlock Text="Лаунчер" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMods" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Tag="Mods" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center"/>
                            <TextBlock Text="Модификации" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavFastFlags" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Tag="FastFlags" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xEB4B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center"/>
                            <TextBlock Text="Настройки движка" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAppearance" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Tag="Appearance" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center"/>
                            <TextBlock Text="Внешний вид" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavShortcuts" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Tag="Shortcuts" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center"/>
                            <TextBlock Text="Ярлыки" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <!-- Разделитель -->
                <Border DockPanel.Dock="Top" Height="1" Background="#2a2a3d" Margin="12,6"/>

                <!-- Нижнее меню -->
                <StackPanel DockPanel.Dock="Top">

                    <RadioButton x:Name="NavFoxstrap" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Tag="FoxstrapPage" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center"/>
                            <TextBlock Text="Foxstrap" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAbout" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Tag="About" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center"/>
                            <TextBlock Text="О Foxstrap" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <!-- Версия снизу -->
                <Border DockPanel.Dock="Bottom" Padding="18,10">
                    <TextBlock Text="v1.0.0 · Foxi005305" Foreground="#45475a"
                               FontSize="11"/>
                </Border>

                <Border/>
            </DockPanel>
        </Border>

        <!-- ═══ КОНТЕНТ ═══ -->
        <ScrollViewer Grid.Column="1" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1e1e2e">
            <StackPanel x:Name="ContentPanel" Margin="32,28,32,20"/>
        </ScrollViewer>

        <!-- ═══ НИЖНЯЯ ПАНЕЛЬ ═══ -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="#181825"
                BorderBrush="#2a2a3d" BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <!-- Режим тестирования -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="TestModeCheck"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="TestMode_Changed"
                              Unchecked="TestMode_Changed"/>
                    <TextBlock Text="Режим тестирования" Foreground="#a6adc8"
                               FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сохранить" Style="{StaticResource BtnPrimary}"
                            Click="SaveButton_Click" Margin="0,0,8,0"/>
                    <Button Content="Закрыть" Style="{StaticResource Btn}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
