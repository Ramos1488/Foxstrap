<Window x:Class="Foxstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foxstrap" Height="400" Width="580"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Background="#1E1E2E" CornerRadius="10"
            BorderBrush="#313244" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
                <TextBlock Text="Foxstrap" FontSize="12"
                           Foreground="#6C7086" VerticalAlignment="Center" Margin="14,0"/>
                <Button Content="✕" Width="36" Height="36"
                        HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#6C7086"
                        BorderBrush="Transparent" FontSize="13"
                        Click="CloseButton_Click" Cursor="Hand"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="24,0,16,16">
                    <Border x:Name="LogoBorder" Width="68" Height="68" CornerRadius="16"
                            Background="#313244" Margin="0,0,0,12" HorizontalAlignment="Left">
                        <TextBlock x:Name="LogoText" Text="F" FontSize="34" FontWeight="Bold"
                                   Foreground="#CBA6F7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Foxstrap" FontSize="20" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                    <TextBlock Text="Версия 1.0.0" FontSize="12" Foreground="#6C7086" Margin="0,3,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="○  " Foreground="#6C7086" FontSize="12"/>
                        <TextBlock Text="О Foxstrap" FontSize="12" Foreground="#CBA6F7"
                                   Cursor="Hand" MouseLeftButtonDown="AboutLink_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="□  " Foreground="#6C7086" FontSize="12"/>
                        <TextBlock Text="Foxstrap Wiki" FontSize="12" Foreground="#CBA6F7"
                                   Cursor="Hand" MouseLeftButtonDown="WikiLink_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦  " Foreground="#6C7086" FontSize="12"/>
                        <TextBlock Text="Roblox Сообщество" FontSize="12" Foreground="#CBA6F7"
                                   Cursor="Hand" MouseLeftButtonDown="CommunityLink_Click"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="#313244"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                    <Button Click="LaunchRoblox_Click" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent"
                            Margin="0,0,0,8" Padding="0" HorizontalContentAlignment="Stretch">
                        <Border Background="#313244" CornerRadius="8" Padding="14,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="→" FontSize="16" Foreground="#CBA6F7" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Запустить Roblox"
                                           FontSize="13" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                           Foreground="#6C7086" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Button>

                    <Button Click="LaunchStudio_Click" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent"
                            Margin="0,0,0,8" Padding="0" HorizontalContentAlignment="Stretch">
                        <Border Background="#313244" CornerRadius="8" Padding="14,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚙" FontSize="15" Foreground="#CBA6F7" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Запустить Roblox Studio"
                                           FontSize="13" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                           Foreground="#6C7086" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Button>

                    <Button Click="OpenSettings_Click" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent"
                            Margin="0,0,0,8" Padding="0" HorizontalContentAlignment="Stretch">
                        <Border Background="#313244" CornerRadius="8" Padding="14,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚙" FontSize="15" Foreground="#CBA6F7" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Настройка параметров"
                                           FontSize="13" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                           Foreground="#6C7086" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Button>

                    <Button Cursor="Hand" Background="Transparent"
                            BorderBrush="Transparent" Padding="0" HorizontalContentAlignment="Stretch">
                        <Border Background="#313244" CornerRadius="8" Padding="14,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="?" FontSize="15" Foreground="#CBA6F7" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Возникли проблемы?"
                                               FontSize="13" Foreground="#CDD6F4"/>
                                    <TextBlock Text="Обратитесь к Wiki за помощью"
                                               FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                           Foreground="#6C7086" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
