<Window x:Class="Foxstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foxstrap" Height="420" Width="560"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Background" Value="#161622"/>
            <Setter Property="BorderBrush" Value="#1E1E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E1E2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#252535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#45475A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F0F19" CornerRadius="10"
            BorderBrush="#1A1A28" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.7"
                              BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Image Source="pack://application:,,,/Assets/foxstrap.png"
                           Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Foxstrap" FontSize="12"
                               Foreground="#35354A" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Width="38" Height="38"
                        HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#35354A"
                        BorderBrush="Transparent" FontSize="14"
                        Click="CloseButton_Click" Cursor="Hand"
                        FocusVisualStyle="{x:Null}"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel -->
                <Grid Grid.Column="0">
                    <StackPanel VerticalAlignment="Center" Margin="22,0,18,20">

                        <!-- Logo -->
                        <Image Source="pack://application:,,,/Assets/foxstrap.png"
                               Width="72" Height="72" HorizontalAlignment="Left"
                               Margin="0,0,0,14"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               x:Name="LogoImage"/>

                        <TextBlock Text="Foxstrap" FontSize="21"
                                   FontWeight="Bold" Foreground="#E0E0EE"/>
                        <TextBlock Text="Версия 1.0.0" FontSize="12"
                                   Foreground="#35354A" Margin="0,2,0,22"/>

                        <!-- Links -->
                        <StackPanel Orientation="Horizontal" Cursor="Hand" Margin="0,0,0,7"
                                    MouseLeftButtonDown="AboutLink_Click">
                            <TextBlock Text="○" FontSize="10" Foreground="#35354A"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Style="{StaticResource LinkText}" Margin="0"
                                       Text="О Foxstrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Cursor="Hand" Margin="0,0,0,7"
                                    MouseLeftButtonDown="WikiLink_Click">
                            <TextBlock Text="□" FontSize="10" Foreground="#35354A"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Style="{StaticResource LinkText}" Margin="0"
                                       Text="Foxstrap Wiki"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Cursor="Hand"
                                    MouseLeftButtonDown="CommunityLink_Click">
                            <TextBlock Text="✦" FontSize="9" Foreground="#35354A"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Style="{StaticResource LinkText}" Margin="0"
                                       Text="Roblox Сообщество"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Column="1" Fill="#1A1A28"/>

                <!-- Right panel -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0">

                    <Button Style="{StaticResource MenuBtn}"
                            Click="LaunchRoblox_Click" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="→" FontSize="16" Foreground="#6C6C8A"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Запустить Roblox"
                                       FontSize="13" Foreground="#C8C8DC"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                       Foreground="#2A2A3E" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuBtn}"
                            Click="LaunchStudio_Click" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔧" FontSize="13" Foreground="#6C6C8A"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Запустить Roblox Studio"
                                       FontSize="13" Foreground="#C8C8DC"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                       Foreground="#2A2A3E" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuBtn}"
                            Click="OpenSettings_Click" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚙" FontSize="14" Foreground="#6C6C8A"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Настройка параметров"
                                       FontSize="13" Foreground="#C8C8DC"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                       Foreground="#2A2A3E" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuBtn}" x:Name="HelpBtn">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="❓" FontSize="13" Foreground="#6C6C8A"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Возникли проблемы?"
                                           FontSize="13" Foreground="#C8C8DC"/>
                                <TextBlock Text="Обратитесь к Wiki за помощью"
                                           FontSize="11" Foreground="#35354A"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                       Foreground="#2A2A3E" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
