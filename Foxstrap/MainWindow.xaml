<Window x:Class="Foxstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        Title="Foxstrap" Height="450" Width="750" 
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="15" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1">
        <Grid>
            <!-- Кнопка закрытия -->
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="15" Background="Transparent" Foreground="Gray" 
                    BorderThickness="0" Cursor="Hand" Click="Close_Click"/>

            <Grid Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая сторона -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Width="80" Height="80" Background="#FF6B00" CornerRadius="20" Margin="0,0,0,20">
                        <TextBlock Text="🦊" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Foxstrap" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Версия 1.0.0" Foreground="Gray" Margin="0,5,0,20"/>
                </StackPanel>

                <!-- Правая сторона (Кнопки) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Height="60" Margin="0,5" Click="Play_Click" Background="#2A2A2A" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="15">
                                    <DockPanel>
                                        <TextBlock Text="➔" Foreground="White" FontSize="20" Margin="0,0,15,0"/>
                                        <TextBlock Text="Запустить Roblox" Foreground="White" FontSize="18"/>
                                        <TextBlock Text="›" Foreground="Gray" FontSize="20" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>