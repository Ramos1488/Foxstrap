<Window x:Class="Foxstrap.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Foxstrap" Height="560" Width="860"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Background="#11111B" CornerRadius="10" BorderBrush="#27273A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
                <TextBlock Text="Настройки Foxstrap" FontSize="12" Foreground="#6C7086"
                           VerticalAlignment="Center" Margin="14,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Width="36" Height="36" Background="Transparent"
                            Foreground="#6C7086" BorderBrush="Transparent"
                            Click="MinimizeButton_Click" Cursor="Hand"/>
                    <Button Content="✕" Width="36" Height="36" Background="Transparent"
                            Foreground="#6C7086" BorderBrush="Transparent"
                            Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,8">
                        <Button x:Name="BtnFoxstrap" Tag="FoxstrapApp"
                                Click="NavButton_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙  " Foreground="#6C7086"/>
                                <TextBlock Text="Foxstrap"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAbout" Tag="About"
                                Click="NavButton_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="?  " Foreground="#6C7086"/>
                                <TextBlock Text="О Foxstrap"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="8,8,8,0">
                        <Button x:Name="BtnIntegrations" Tag="Integrations"
                                Click="NavButton_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+  " Foreground="#6C7086"/>
                                <TextBlock Text="Интеграции"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnLauncher" Tag="Launcher"
                                Click="NavButton_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▷  " Foreground="#6C7086"/>
                                <TextBlock Text="Лаунчер"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMods" Tag="Mods"
                                Click="NavButton_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞  " Foreground="#6C7086"/>
                                <TextBlock Text="Модификации"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnFastFlags" Tag="FastFlags"
                                Click="NavButton_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊟  " Foreground="#6C7086"/>
                                <TextBlock Text="Настройки движка"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAppearance" Tag="Appearance"
                                Click="NavButton_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◫  " Foreground="#6C7086"/>
                                <TextBlock Text="Внешний вид"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnShortcuts" Tag="Shortcuts"
                                Click="NavButton_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞  " Foreground="#6C7086"/>
                                <TextBlock Text="Ярлыки"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Rectangle Grid.Column="1" Fill="#313244"/>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,4,0">
                    <StackPanel x:Name="ContentPanel" Margin="28,20,28,20"/>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Background="#0D0D17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <CheckBox x:Name="TestModeCheck" Content="Режим тестирования"
                              Foreground="#6C7086" FontSize="12" IsChecked="False"
                              Checked="TestMode_Changed" Unchecked="TestMode_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="Сохранить" Click="SaveButton_Click"
                            Padding="20,8" Margin="0,0,8,0"
                            Background="#CBA6F7" Foreground="#1E1E2E"
                            BorderBrush="Transparent" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Закрыть" Click="CloseButton_Click"
                            Padding="20,8" Background="#1E1E2E"
                            Foreground="#CDD6F4" BorderBrush="#45475A" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

