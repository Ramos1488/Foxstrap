<Window x:Class="Foxstrap.Windows.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установщик Foxstrap" Height="480" Width="640"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Background="#11111B" CornerRadius="10"
            BorderBrush="#27273A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
                <TextBlock Text="Установщик Foxstrap" FontSize="12"
                           Foreground="#45475A" VerticalAlignment="Center" Margin="14,0"/>
                <Button Content="✕" Width="36" Height="36" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#45475A"
                        BorderBrush="Transparent" Click="CloseButton_Click" Cursor="Hand"/>
            </Grid>

            <!-- Страницы -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Боковое меню -->
                <StackPanel Grid.Column="0" Margin="0,16,0,0">
                    <Border x:Name="NavWelcome" Padding="16,10" Margin="8,0"
                            CornerRadius="6" Background="#1E1E2E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NavWelcomeCircle" Text="⊙  " Foreground="#CBA6F7"/>
                            <TextBlock Text="Добро пожаловать" FontSize="13" Foreground="#CDD6F4"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavInstall" Padding="16,10" Margin="8,4,8,0" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NavInstallCircle" Text="○  " Foreground="#45475A"/>
                            <TextBlock Text="Установка" FontSize="13" Foreground="#6C7086"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavDone" Padding="16,10" Margin="8,4,8,0" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NavDoneCircle" Text="○  " Foreground="#45475A"/>
                            <TextBlock Text="Завершение" FontSize="13" Foreground="#6C7086"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="#27273A"/>

                <!-- Содержимое страниц -->
                <Grid Grid.Column="2" Margin="28,20,28,0">

                    <!-- Страница 1: Добро пожаловать -->
                    <StackPanel x:Name="PageWelcome" Visibility="Visible">
                        <TextBlock Text="Добро пожаловать" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#CDD6F4"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Спасибо за загрузку Foxstrap." FontSize="13"
                                   Foreground="#A6ADC8" Margin="0,0,0,16"
                                   TextWrapping="Wrap"/>
                        <TextBlock FontSize="13" Foreground="#A6ADC8"
                                   TextWrapping="Wrap" Margin="0,0,0,16">
                            Foxstrap — альтернативный лаунчер для Roblox с
                            расширенными возможностями: FastFlags, моды,
                            Discord RPC и многое другое.
                        </TextBlock>
                        <TextBlock FontSize="13" Foreground="#A6ADC8"
                                   TextWrapping="Wrap">
                            Нажмите «Далее» для продолжения.
                        </TextBlock>
                    </StackPanel>

                    <!-- Страница 2: Установка -->
                    <StackPanel x:Name="PageInstall" Visibility="Collapsed">
                        <TextBlock Text="Установка" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#CDD6F4"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Выберите место для установки" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#CDD6F4"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" Foreground="#6C7086"
                                   TextWrapping="Wrap" Margin="0,0,0,12">
                            Foxstrap будет установлен в указанную папку.
                        </TextBlock>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1E1E2E" CornerRadius="6" Padding="10,8">
                                <TextBlock x:Name="InstallPathText" FontSize="12"
                                           Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Content="📁  Обзор"
                                    Click="Browse_Click" Margin="6,0,0,0"
                                    Padding="10,8" Background="#1E1E2E"
                                    Foreground="#CDD6F4" BorderBrush="#27273A"
                                    FontSize="12" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="↺  Сбросить"
                                    Click="Reset_Click" Margin="6,0,0,0"
                                    Padding="10,8" Background="#1E1E2E"
                                    Foreground="#CDD6F4" BorderBrush="#27273A"
                                    FontSize="12" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Ярлыки" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CDD6F4" Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" Foreground="#6C7086"
                                   TextWrapping="Wrap" Margin="0,0,0,10">
                            Ярлыки вызывают меню запуска с несколькими вариантами.
                        </TextBlock>
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Background="#1E1E2E" CornerRadius="8"
                                    Padding="14,10" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ярлык на рабочем столе"
                                               FontSize="12" Foreground="#CDD6F4"
                                               VerticalAlignment="Center"/>
                                    <CheckBox x:Name="DesktopShortcut" Grid.Column="1"
                                              IsChecked="True"
                                              Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                            <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ярлык в меню «Пуск»"
                                               FontSize="12" Foreground="#CDD6F4"
                                               VerticalAlignment="Center"/>
                                    <CheckBox x:Name="StartMenuShortcut" Grid.Column="1"
                                              IsChecked="True"
                                              Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Страница 3: Прогресс/Завершение -->
                    <StackPanel x:Name="PageDone" Visibility="Collapsed">
                        <TextBlock Text="Установка" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#CDD6F4"
                                   Margin="0,0,0,20"/>
                        <Border Width="72" Height="72" CornerRadius="16"
                                Background="#1E1E2E" HorizontalAlignment="Left"
                                Margin="0,0,0,20">
                            <Image Source="pack://application:,,,/Assets/foxstrap.png"
                                   Width="54" Height="54"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="StatusLabel" Text="Подготовка..."
                                   FontSize="14" Foreground="#CDD6F4"
                                   Margin="0,0,0,12"/>
                        <ProgressBar x:Name="ProgressBar" Height="6"
                                     Background="#1E1E2E" Foreground="#CBA6F7"
                                     BorderBrush="Transparent"
                                     Minimum="0" Maximum="100" Value="0"
                                     Margin="0,0,0,8"/>
                        <TextBlock x:Name="PercentLabel" Text="0%"
                                   FontSize="12" Foreground="#45475A"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Нижняя панель -->
            <Grid Grid.Row="2" Background="#0D0D17">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button x:Name="BackButton" Content="Назад"
                            Click="Back_Click" Padding="18,8" Margin="0,0,8,0"
                            Background="#1E1E2E" Foreground="#CDD6F4"
                            BorderBrush="#27273A" Cursor="Hand" IsEnabled="False"/>
                    <Button x:Name="NextButton" Content="Далее"
                            Click="Next_Click" Padding="18,8" Margin="0,0,8,0"
                            Background="#CBA6F7" Foreground="#1E1E2E"
                            BorderBrush="Transparent" FontWeight="SemiBold"
                            Cursor="Hand"/>
                    <Button Content="Закрыть" Click="CloseButton_Click"
                            Padding="18,8" Background="#1E1E2E"
                            Foreground="#CDD6F4" BorderBrush="#27273A"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
